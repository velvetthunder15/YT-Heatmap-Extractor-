# ======================= YouTube Heatmap Extractor =======================
# Copy to .env and edit. Every variable has a safe default except API_KEY_PEPPER.

# --- Core ---
REDIS_URL=redis://localhost:6379/0
PUBLIC_BASE_URL=                 # e.g. https://heatmap.example.com (used in status_url)
CLOUDFLARE_TUNNEL_TOKEN=         # optional: named tunnel token for a permanent URL (setup-permanent-url.bat)
LOG_LEVEL=INFO
CORS_ORIGINS=*                   # comma-separated origins, * for any (needed by the web dashboard), empty = disabled
WEB_CONCURRENCY=2                # gunicorn workers for the API container
PORT=8000

# --- Auth & limits ---
REQUIRE_API_KEY=true
API_KEY_PEPPER=replace-with-a-long-random-secret   # changing it invalidates every key
API_KEY_HASHES=                  # optional static keys (HMAC hashes, comma-separated)
DEFAULT_RATE_LIMIT_PER_MIN=30
DEFAULT_DAILY_QUOTA=500

# --- Cache & jobs ---
CACHE_TTL_OFFICIAL=86400         # 24h
CACHE_TTL_ESTIMATED=604800       # 7 days
JOB_RESULT_TTL=86400
JOB_TIMEOUT=900                  # seconds per job
OFFICIAL_TIMEOUT=25              # fast-path timeout talking to YouTube
WORKER_CONCURRENCY=2             # worker processes per worker container
GLOBAL_MAX_JOBS=4                # cluster-wide cap on heavy jobs
TMP_DIR=/tmp/yt-heatmap

# --- Processing ---
MAX_ESTIMATE_DURATION=3600       # 60 min cap for estimated mode
WINDOW_SECONDS=10
MIN_WINDOW_SECONDS=5
MAX_WINDOW_SECONDS=60
MAX_TOP=20
MERGE_TOLERANCE=0.05

WEIGHT_COMMENTS=0.35
WEIGHT_TRANSCRIPT=0.25
WEIGHT_AUDIO=0.25
WEIGHT_VISUAL=0.15

ENABLE_COMMENTS=true
ENABLE_TRANSCRIPT=true
ENABLE_AUDIO=true
ENABLE_VISUAL=true

MIN_TIMESTAMPED_COMMENTS=10
COMMENT_SPREAD_SECONDS=5
MAX_COMMENTS=2000
VISUAL_MAX_HEIGHT=360

# --- YouTube access ---
YT_PROXY=                        # e.g. http://user:pass@residential-proxy:8000
YT_COOKIES_FILE=                 # e.g. /secrets/cookies.txt (Netscape format)
YT_API_KEY=                      # YouTube Data API v3 key for comments (optional)
YT_API_DAILY_QUOTA=10000
RETRY_ATTEMPTS=3
RETRY_BACKOFF=2.0

# --- Optional LLM pass on transcripts (OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_BLEND=0.5

# --- Webhooks ---
ALLOW_WEBHOOKS=true
WEBHOOK_TIMEOUT=10
